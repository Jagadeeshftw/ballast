{
  "name": "ballast-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:migrate": "node backend/run.mjs migrate.ts",
    "watcher": "node backend/run.mjs watcher.ts",
    "watcher:once": "node backend/run.mjs watcher.ts --once",
    "watcher:probe": "node backend/run.mjs probe.ts",
    "test:backend": "tsx --test backend/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "next": "15.5.25",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "viem": "2.56.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.7.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.23.13",
    "typescript": "5.9.2"
  }
}
